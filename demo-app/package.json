    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "5.9.2"
  }
}
