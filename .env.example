# Local-only demonstration settings. Replace all values outside local development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://acme:change-me@localhost:5432/acme_commerce
POSTGRES_DB=acme_commerce
POSTGRES_USER=acme
POSTGRES_PASSWORD=change-me
AUTH_SECRET=replace-with-at-least-32-random-characters
PAYMENT_SERVICE_URL=http://localhost:8080
PAYMENT_TIMEOUT_MS=3000
PAYMENT_MAX_RETRIES=2
SIMULATE_PRODUCT_DELAY_MS=0

# Performance execution
TEST_ENV=LOCAL
BASE_URL=http://localhost:3000
TEST_USERNAME=perf-user-1@acme.test
TEST_PASSWORD=performance-test
REQUEST_TIMEOUT=15s
TARGET_VUS=5
TEST_DURATION=30s
MAX_VUS=500
MAX_DURATION=30m
ALLOW_REMOTE_LOAD_TEST=false
RESULT_FILE=results/current/summary.json
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
